const path = require('path');

module.exports = {
  // Kept OUTSIDE migrations/ on purpose: sequelize-cli treats every .js file in
  // the migrations directory as a migration, so a config file living there shows
  // up as a pending migration and `db:migrate` tries to execute it.
  'config': path.resolve('config', 'sequelize-cli.js'),
  'models-path': path.resolve('src', 'models', 'sequelize'),
  'seeders-path': path.resolve('seeders'),
  'migrations-path': path.resolve('migrations'),
};
