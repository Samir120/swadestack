import Stripe from 'stripe';
import { config } from '../config/environment';
import OrdersService from './OrdersService';
import PartialPaymentService from './PartialPaymentService';
import PaymentRepository from '../integration/repositories/PaymentRepository';
import { PaymentPhase } from '../models/sequelize/Payment';
import { OrderEmailService } from './OrderEmailService';

/**
 * Payment Service - Stripe Integration
 * Handles payment processing through Stripe
 */
export class PaymentService {
  private stripe: Stripe;
  private ordersService: OrdersService;
  private partialPaymentService: PartialPaymentService;
  private paymentRepository: PaymentRepository;
  private orderEmailService: OrderEmailService;

  constructor() {
    this.stripe = new Stripe(config.stripe.secretKey, {
      apiVersion: '2025-02-24.acacia',
    });
    this.ordersService = new OrdersService();
    this.partialPaymentService = new PartialPaymentService();
    this.paymentRepository = new PaymentRepository();
    this.orderEmailService = new OrderEmailService();
  }

  /**
   * Create a payment intent for an order
   */
  async createPaymentIntent(
    orderId: string,
    returnUrl: string
  ): Promise<{ clientSecret: string; paymentIntentId: string }> {
    // Get order details
    const order = await this.ordersService.getOrderById(orderId);
    if (!order) {
      throw new Error('Order not found');
    }

    if (order.status !== 'pending') {
      throw new Error('Order is not in pending status');
    }

    // Create payment intent
    const paymentIntent = await this.stripe.paymentIntents.create({
      amount: Math.round(order.totalAmount * 100), // Convert to cents
      currency: order.currency.toLowerCase(),
      metadata: {
        orderId: order.id,
        orderNumber: order.orderNumber,
      },
      receipt_email: order.email,
      description: `Order ${order.orderNumber}`,
    });

    return {
      clientSecret: paymentIntent.client_secret!,
      paymentIntentId: paymentIntent.id,
    };
  }

  /**
   * Handle Stripe webhook events
   */
  async handleWebhook(
    signature: string,
    payload: string | Buffer
  ): Promise<void> {
    let event: Stripe.Event;

    try {
      event = this.stripe.webhooks.constructEvent(
        payload,
        signature,
        config.stripe.webhookSecret
      );
    } catch (err) {
      throw new Error(`Webhook signature verification failed: ${err}`);
    }

    // Handle the event
    switch (event.type) {
      case 'payment_intent.succeeded':
        console.log(`✅ Processing payment success webhook`);
        await this.handlePaymentSuccess(event.data.object as Stripe.PaymentIntent);
        break;

      case 'payment_intent.payment_failed':
        await this.handlePaymentFailure(event.data.object as Stripe.PaymentIntent);
        break;

      default:
        console.log(`Unhandled event type: ${event.type}`);
    }
  }

  /**
   * Handle successful payment
   */
/**
 * Handle successful payment
 */
private async handlePaymentSuccess(paymentIntent: Stripe.PaymentIntent): Promise<void> {
  const orderId = paymentIntent.metadata.orderId;
  const phase = paymentIntent.metadata.phase as PaymentPhase;
  const paymentId = paymentIntent.metadata.paymentId;

  console.log(`📧 Processing payment success for order: ${orderId}, phase: ${phase}`); // Add this

  if (!orderId) {
    console.error('Order ID not found in payment intent metadata');
    return;
  }

  try {
    let shouldSendEmail = false;

    // Check if this is a partial payment
    if (phase && paymentId) {
      await this.handlePartialPaymentSuccess(paymentIntent, phase, paymentId);
      shouldSendEmail = (phase === 'final');
      console.log(`Phase: ${phase}, shouldSendEmail: ${shouldSendEmail}`); // Add this
    } else {
      await this.ordersService.updateOrderStatus(orderId, {
        status: 'paid',
        paymentId: paymentIntent.id,
      });
      console.log(`✅ Order ${orderId} marked as paid`);
      shouldSendEmail = true;
    }

    if (shouldSendEmail) {
      console.log(`📧 Attempting to send email for order ${orderId}`); // Add this
      const order = await this.ordersService.getOrderById(orderId);
      
      if (order) {
        try {
          await this.orderEmailService.sendOrderConfirmation({
            orderId: order.id,
            email: order.email,
            customerName: order.firstName || 'Customer',
            orderItems: order.items.map((item: any) => ({
              name: item.serviceName,
              quantity: item.quantity,
              price: item.price
            })),
            totalAmount: order.totalAmount,
            orderDate: order.createdAt,
            language: 'en'
          });
          console.log(`✅ Order confirmation email sent for order ${order.orderNumber}`);
        } catch (emailError) {
          console.error('Failed to send order confirmation email:', emailError);
        }
      } else {
        console.error(`Order not found: ${orderId}`); // Add this
      }
    } else {
      console.log(`📧 Skipping email (not final payment yet)`); // Add this
    }

  } catch (error) {
    console.error('Error updating order status:', error);
  }
}
  /**
   * Handle partial payment success (initial or final)
   */
  private async handlePartialPaymentSuccess(
    paymentIntent: Stripe.PaymentIntent,
    phase: PaymentPhase,
    paymentId: string
  ): Promise<void> {
    // Update Payment record
    await this.paymentRepository.updatePaymentStatus(paymentId, 'succeeded', {
      stripePaymentIntentId: paymentIntent.id,
      completedAt: new Date().toISOString(),
    });

    // Get order
    const orderId = paymentIntent.metadata.orderId;
    const order = await this.ordersService.getOrderById(orderId);
    if (!order) {
      throw new Error('Order not found');
    }

    // Update order status based on phase
    if (phase === 'initial') {
      await this.ordersService.updateOrderStatus(orderId, {
        status: 'partial_paid',
      });
      console.log(`✅ Order ${order.orderNumber} - Initial payment succeeded (50%)`);
    } else if (phase === 'final') {
      await this.ordersService.updateOrderStatus(orderId, {
        status: 'paid',
        paymentId: paymentIntent.id,
      });
      console.log(`✅ Order ${order.orderNumber} - Final payment succeeded (100% complete)`);
    }
  }

  /**
   * Handle failed payment
   */
  private async handlePaymentFailure(paymentIntent: Stripe.PaymentIntent): Promise<void> {
    const orderId = paymentIntent.metadata.orderId;
    
    if (!orderId) {
      console.error('Order ID not found in payment intent metadata');
      return;
    }

    console.log(`❌ Payment failed for order ${orderId}`);
    
    // TODO: Send payment failure notification to customer
  }

  /**
   * Create payment intent for specific phase (initial/final/full)
   */
  async createPhasePaymentIntent(
    orderId: string,
    phase: PaymentPhase,
    returnUrl: string
  ): Promise<{ clientSecret: string; paymentIntentId: string; paymentId: string }> {
    // Get order details
    const order = await this.ordersService.getOrderById(orderId);
    if (!order) {
      throw new Error('Order not found');
    }

    // Validate payment phase
    const validation = await this.partialPaymentService.validatePaymentPhase(orderId, phase);
    if (!validation.valid) {
      throw new Error(`Invalid payment phase: ${validation.reason}`);
    }

    // Get the appropriate payment record
    let paymentRecord;
    let amount: number;

    if (phase === 'full') {
      // Full payment for non-partial orders
      amount = order.totalAmount;
    } else {
      // Get payment record for initial or final phase
      const payments = await this.paymentRepository.findByOrderId(orderId);
      paymentRecord = payments.find(p => p.phase === phase);

      if (!paymentRecord) {
        throw new Error(`Payment record not found for phase: ${phase}`);
      }

      amount = parseFloat(paymentRecord.amount.toString());
    }

    // Create Stripe payment intent
    const paymentIntent = await this.stripe.paymentIntents.create({
      amount: Math.round(amount * 100), // Convert to cents
      currency: order.currency.toLowerCase(),
      metadata: {
        orderId: order.id,
        orderNumber: order.orderNumber,
        phase: phase,
        paymentId: paymentRecord?.id || '',
      },
      receipt_email: order.email,
      description: `Order ${order.orderNumber} - ${phase === 'initial' ? 'Initial Payment (50%)' : phase === 'final' ? 'Final Payment (50%)' : 'Full Payment'}`,
    });

    // Update payment record with payment intent ID
    if (paymentRecord) {
      await this.paymentRepository.updatePaymentIntentId(paymentRecord.id, paymentIntent.id);
    }

    console.log(`✓ Created ${phase} payment intent for order ${order.orderNumber}: ${paymentIntent.id}`);

    return {
      clientSecret: paymentIntent.client_secret!,
      paymentIntentId: paymentIntent.id,
      paymentId: paymentRecord?.id || '',
    };
  }

  /**
   * Retrieve payment intent
   */
  async retrievePaymentIntent(paymentIntentId: string): Promise<Stripe.PaymentIntent> {
    return await this.stripe.paymentIntents.retrieve(paymentIntentId);
  }

  /**
   * Refund payment
   */
  async refundPayment(paymentIntentId: string, amount?: number): Promise<Stripe.Refund> {
    const refundData: Stripe.RefundCreateParams = {
      payment_intent: paymentIntentId,
    };

    if (amount) {
      refundData.amount = Math.round(amount * 100); // Convert to cents
    }

    return await this.stripe.refunds.create(refundData);
  }

  /**
   * Confirm payment success (called from client after Stripe confirmation)
   * This is a fallback for when webhooks aren't configured (e.g., local development)
   */
  async confirmPaymentSuccess(
    orderId: string,
    phase: PaymentPhase,
    paymentId: string,
    paymentIntentId: string
  ): Promise<void> {
    // Retrieve and verify payment intent
    const paymentIntent = await this.stripe.paymentIntents.retrieve(paymentIntentId);

    if (paymentIntent.status !== 'succeeded') {
      throw new Error('Payment has not succeeded');
    }

    // Handle partial payment success
    if (phase && paymentId) {
      await this.handlePartialPaymentSuccess(paymentIntent, phase, paymentId);
    } else {
      // Legacy full payment handling
      await this.ordersService.updateOrderStatus(orderId, {
        status: 'paid',
        paymentId: paymentIntentId,
      });
      console.log(`✅ Order ${orderId} marked as paid (client confirmation)`);
    }
  }
}

export default PaymentService;
